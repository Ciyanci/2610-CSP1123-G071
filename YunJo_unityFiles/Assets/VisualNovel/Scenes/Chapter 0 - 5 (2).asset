%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e32d70991a71c9649876788061c5a6cd, type: 3}
  m_Name: Chapter 0 - 5 (2)
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  hasChapterIntro: 0
  chapterNumber: Chapter 0 - 5
  chapterName: "\u2018A desperate dog leaps over the wall.\u2019"
  hasBattleScene: 0
  sentences:
  - text: "That was too close\u2026 "
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: "Goin' for a gut n' dash in the upper streets\u2026 we better make some
      good cash for that risk. "
    speaker: {fileID: 11400000, guid: 7783895842adf0d4c88a132f6f84318d, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 7649247613345778094, guid: 5fcc4f8cd9fbf4f4c847f555bf637680, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Only jobs we can take right now. Gotta survive and climb outta this hell
      hole by any means necessary. '
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Still dreamin'' about getting into a Triad, huh? '
    speaker: {fileID: 11400000, guid: 7783895842adf0d4c88a132f6f84318d, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 7649247613345778094, guid: 5fcc4f8cd9fbf4f4c847f555bf637680, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Heh, you know it. '
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Hey, I hate to break the moment, but we''ve still gotta sell off this
      sucker''s guts and belongings first. Then, we''ve gotta prepare some cash to
      offer the Han Tong. '
    speaker: {fileID: 11400000, guid: db9ed753fab686e4f90beb5635327654, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -6487258757721845407, guid: a008bc2e4b7a8254a97be42dc6749ddb, type: 3}
    characterPos3: 0
  - text: "Mmn. This could very well be our chance to get connected with the Han
      Tong, become real syndicate affiliates. Maybe even get into a Triad with the
      connections we'll make\u2026 "
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Alright, what''s our harvest lookin'' like? '
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: "\u2026 "
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Oi! Is this a damn joke or what? You sure you scooped the right stuff
      out?! '
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: "Ugh\u2026 I told you, organ harvesting's delicate work, you just can't
      rush it! Besides, that guy didn't even have a single proper organ inside of
      him, it's all messed up! "
    speaker: {fileID: 11400000, guid: db9ed753fab686e4f90beb5635327654, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -6487258757721845407, guid: a008bc2e4b7a8254a97be42dc6749ddb, type: 3}
    characterPos3: 0
  - text: 'When you said messed up, I didn''t expect it to look like a damn blob
      of someone''s leftovers inside a trash can! Looks like someone else blew them
      up and sewed the guy back up, hard to believe he was even walkin'' to begin
      with. Some rich lunatic scientists probably got to him before we did. '
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: "Damn it\u2026 knew he was too easy to take down for someone his size.
      Thought we got a real catch there. Some stitchwork those scientists did, though\u2026
      didn't even see a damn stitch. "
    speaker: {fileID: 11400000, guid: 7783895842adf0d4c88a132f6f84318d, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 7649247613345778094, guid: 5fcc4f8cd9fbf4f4c847f555bf637680, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Well? At least we have some stuff from his bag that we can sell. '
    speaker: {fileID: 11400000, guid: 7783895842adf0d4c88a132f6f84318d, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 7649247613345778094, guid: 5fcc4f8cd9fbf4f4c847f555bf637680, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: "\u2026 "
    speaker: {fileID: 11400000, guid: 7783895842adf0d4c88a132f6f84318d, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 7649247613345778094, guid: 5fcc4f8cd9fbf4f4c847f555bf637680, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'I don''t even know what I''m looking at. '
    speaker: {fileID: 11400000, guid: 7783895842adf0d4c88a132f6f84318d, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 7649247613345778094, guid: 5fcc4f8cd9fbf4f4c847f555bf637680, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: "Whatever scrap metal we can get from all this\u2026 it ain't gonna afford
      us our next meal, let alone cover the fee that we owe to the Han Tong\u2026 "
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'What''s that thing? '
    speaker: {fileID: 11400000, guid: db9ed753fab686e4f90beb5635327654, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -6487258757721845407, guid: a008bc2e4b7a8254a97be42dc6749ddb, type: 3}
    characterPos3: 0
  - text: 'Looks like a scroll. '
    speaker: {fileID: 11400000, guid: 7783895842adf0d4c88a132f6f84318d, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 7649247613345778094, guid: 5fcc4f8cd9fbf4f4c847f555bf637680, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Lemme see it. '
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: "Invitation\u2026 Garden\u2026? The hell's this about\u2026? "
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Rewards from a trial? '
    speaker: {fileID: 11400000, guid: db9ed753fab686e4f90beb5635327654, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -6487258757721845407, guid: a008bc2e4b7a8254a97be42dc6749ddb, type: 3}
    characterPos3: 0
  - text: "I dunno\u2026 sounds like some scam. It was a flop after all. Payment's
      due tomorrow as well\u2026 "
    speaker: {fileID: 11400000, guid: 7783895842adf0d4c88a132f6f84318d, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 7649247613345778094, guid: 5fcc4f8cd9fbf4f4c847f555bf637680, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'One more round of a gut n'' dash? '
    speaker: {fileID: 11400000, guid: db9ed753fab686e4f90beb5635327654, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -6487258757721845407, guid: a008bc2e4b7a8254a97be42dc6749ddb, type: 3}
    characterPos3: 0
  - text: 'Ain''t no time for that. Too little time for too much prep. '
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: "\u2026we're heading for this garden. "
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: "I don't know if this is real or not, or what rewards we'll even get, but\u2026
      but we're outta options. Only chance we have is this. "
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: 'Woah, hey! Isn''t this basically suicide? Who the hell just gives out
      invitations to private property in this world without any ulterior motives?
      We don''t know what kinda place it is. '
    speaker: {fileID: 11400000, guid: 7783895842adf0d4c88a132f6f84318d, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -3798211013133917639, guid: 924f6a9f2eb222449b1fe0598a2ac9a4, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 7649247613345778094, guid: 5fcc4f8cd9fbf4f4c847f555bf637680, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  - text: Can't be worse than getting pummeled to death by the Han Tong, or getting
      executed by the Guard Department; we're screwed! If ya wanna live, ya better
      shut yer asses up and follow me!
    speaker: {fileID: 11400000, guid: 6661f94fc4b8f674e82b03f14bac71df, type: 2}
    jobTitle: Thug
    characterSprite: {fileID: -8889834946608363298, guid: 330a99bae833e2e46b3f461d3b86e6f3, type: 3}
    characterPos: 2
    characterSprite2: {fileID: 1251618067618672417, guid: 52cf599261243ae44a45cfdc854b2cee, type: 3}
    characterPos2: 1
    characterSprite3: {fileID: -3180170880247799624, guid: 2b8b07f61ca84aa4eae2c1fa15773c8e, type: 3}
    characterPos3: 0
  backgroud: {fileID: 7021770441055839263, guid: 322bd11d38011744f9f4c97a5c5be4c8, type: 3}
  nextScene: {fileID: 11400000, guid: acb4eb3c0cc679344b2a42a6686e8503, type: 2}
