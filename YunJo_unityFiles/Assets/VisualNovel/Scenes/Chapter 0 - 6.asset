MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e32d70991a71c9649876788061c5a6cd, type: 3}
  m_Name: Chapter 0 - 6
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  hasChapterIntro: 1
  chapterNumber: Chapter 0 - 6
  chapterName: Caretaker, Kan Section
  hasBattleScene: 0
  battleSceneName: 
  loadMap: 0
  sentences:
  - text: Hmph... is it really so important to belong to a renowned triad?
    speaker: {fileID: 11400000, guid: 9551ecb160c9ae0458976bafb3aae211, type: 2}
    jobTitle: Head Caretaker
    characterSprite: {fileID: 3656839501610869304, guid: 2b31f755715f9ab4488e2118816696c6, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -5206761803832305590, guid: 8ea384a28134a4640a5836ccbd70faaf, type: 3}
    characterPos3: 0
  - text: "To be fair\u2026 it's all part of life in the Mainland. Whether you're
      from the slums or the upper class, you have to belong to a group. Life gets
      too hard otherwise. "
    speaker: {fileID: 11400000, guid: 4444d0eef7e7c2044a7431024e07105a, type: 2}
    jobTitle: Caretaker
    characterSprite: {fileID: -5857114442203394712, guid: a5d7d45117a6bc2438c991599d5a350c, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -4777918531010614747, guid: 34ee96cfd07cb8446ae90d1d480e3754, type: 3}
    characterPos3: 0
  - text: "Well, in any case\u2026 there has been a few rearrangements to your life
      here in the Garden now, Xiangzi. "
    speaker: {fileID: 11400000, guid: 9551ecb160c9ae0458976bafb3aae211, type: 2}
    jobTitle: Head Caretaker
    characterSprite: {fileID: 3656839501610869304, guid: 2b31f755715f9ab4488e2118816696c6, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -5206761803832305590, guid: 8ea384a28134a4640a5836ccbd70faaf, type: 3}
    characterPos3: 0
  - text: 'Instead of being the sole Caretaker of one section, I believe you should
      serve as my assistant. It would be most beneficial to the both of us if you
      worked alongside the Caretakers of each section and gained experience that
      way. '
    speaker: {fileID: 11400000, guid: 9551ecb160c9ae0458976bafb3aae211, type: 2}
    jobTitle: Head Caretaker
    characterSprite: {fileID: 3656839501610869304, guid: 2b31f755715f9ab4488e2118816696c6, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -5206761803832305590, guid: 8ea384a28134a4640a5836ccbd70faaf, type: 3}
    characterPos3: 0
  - text: "\u2026 "
    speaker: {fileID: 11400000, guid: 4444d0eef7e7c2044a7431024e07105a, type: 2}
    jobTitle: Caretaker
    characterSprite: {fileID: -5857114442203394712, guid: a5d7d45117a6bc2438c991599d5a350c, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -4777918531010614747, guid: 34ee96cfd07cb8446ae90d1d480e3754, type: 3}
    characterPos3: 0
  - text: 'Excuse me? '
    speaker: {fileID: 11400000, guid: 4444d0eef7e7c2044a7431024e07105a, type: 2}
    jobTitle: Caretaker
    characterSprite: {fileID: -5857114442203394712, guid: a5d7d45117a6bc2438c991599d5a350c, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -4777918531010614747, guid: 34ee96cfd07cb8446ae90d1d480e3754, type: 3}
    characterPos3: 0
  - text: 'You seriously can''t expect me to be able to take on that much responsibility?! '
    speaker: {fileID: 11400000, guid: 4444d0eef7e7c2044a7431024e07105a, type: 2}
    jobTitle: Caretaker
    characterSprite: {fileID: -5857114442203394712, guid: a5d7d45117a6bc2438c991599d5a350c, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -4777918531010614747, guid: 34ee96cfd07cb8446ae90d1d480e3754, type: 3}
    characterPos3: 0
  - text: 'Settle down. Your responsibilities remain virtually the same as before,
      only this time you will have to traverse across each section and aid the section''s
      respective Caretakers. '
    speaker: {fileID: 11400000, guid: 9551ecb160c9ae0458976bafb3aae211, type: 2}
    jobTitle: Head Caretaker
    characterSprite: {fileID: 3656839501610869304, guid: 2b31f755715f9ab4488e2118816696c6, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -5206761803832305590, guid: 8ea384a28134a4640a5836ccbd70faaf, type: 3}
    characterPos3: 0
  - text: 'My decision is final. You can start making your way over to the Kan Section
      now, I have informed He Xiangu, she will be waiting for your arrival. '
    speaker: {fileID: 11400000, guid: 9551ecb160c9ae0458976bafb3aae211, type: 2}
    jobTitle: Head Caretaker
    characterSprite: {fileID: 3656839501610869304, guid: 2b31f755715f9ab4488e2118816696c6, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -5206761803832305590, guid: 8ea384a28134a4640a5836ccbd70faaf, type: 3}
    characterPos3: 0
  - text: "\u2026yes sir. "
    speaker: {fileID: 11400000, guid: 4444d0eef7e7c2044a7431024e07105a, type: 2}
    jobTitle: Caretaker
    characterSprite: {fileID: -5857114442203394712, guid: a5d7d45117a6bc2438c991599d5a350c, type: 3}
    characterPos: 2
    characterSprite2: {fileID: -4080215019528799530, guid: 96e4f96bdd6a53347b84a2a1642bbe73, type: 3}
    characterPos2: 9
    characterSprite3: {fileID: -4777918531010614747, guid: 34ee96cfd07cb8446ae90d1d480e3754, type: 3}
    characterPos3: 0
  backgroud: {fileID: -2889761728585982002, guid: dde821efbab0ba74195bb14d40e3d0b2, type: 3}
  nextScene: {fileID: 11400000, guid: 2b72ed17c966ca246b3b7a52b638ebe3, type: 2}
