  chapterNumber: Chapter 0 - 1
  chapterName: "\u2018An old man loses his horse; \u2019"
  sentences:
  - text: Impermanence is of natural order, to defy it is to defy nature itself.
    speaker: {fileID: 11400000, guid: c19b252c3ea4ae44dbe8b2b78b1186e7, type: 2}
    characterSprite: {fileID: 0}
    characterPos: 0
    characterSprite2: {fileID: 0}
    characterPos2: 0
  - text: "And yet even so\u2026 this garden\u2026"
    speaker: {fileID: 11400000, guid: c19b252c3ea4ae44dbe8b2b78b1186e7, type: 2}
    characterSprite: {fileID: 0}
    characterPos: 0
    characterSprite2: {fileID: 0}
